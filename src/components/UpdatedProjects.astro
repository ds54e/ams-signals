---
import { sitePath } from '../lib/paths';
import { formatDate } from '../lib/date-format';
interface Props {
  domain: 'analog' | 'digital';
  title: string;
  projects: { id: string; name: string; description: string; date: string }[];
}
const { domain, title, projects } = Astro.props;
---
<section class="dashboard-panel updated-card" aria-labelledby={`${domain}-updated-heading`}>
  <div class="panel-heading"><h2 id={`${domain}-updated-heading`}>{title}</h2><a class="dashboard-link" href={sitePath(`${domain}/`)}>View catalog <span aria-hidden="true">→</span></a></div>
  <ol class="updated-list" data-updated-projects={domain}>
    {projects.map((project) => <li data-updated-project={project.id}>
      <span class="project-symbol" aria-hidden="true"><svg viewBox="0 0 24 24">{domain === 'analog' ? <path d="M2 12h3l2.5-8 4.5 16 4-12 2 4h4" /> : <><rect x="5" y="5" width="14" height="14" rx="2" /><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3" /></>}</svg></span>
      <div class="updated-copy"><div class="updated-title"><h3><a href={sitePath(`${domain}/#${project.id}--name`)}>{project.name}</a></h3>{project.date ? <time datetime={project.date}>{formatDate(project.date)}</time> : <span>Activity not fetched</span>}</div><p>{project.description}</p></div>
    </li>)}
  </ol>
</section>
