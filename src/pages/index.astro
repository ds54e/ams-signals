---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventExplorer from '../components/EventExplorer.astro';

const [events, companies, people] = await Promise.all([
  getCollection('events'),
  getCollection('companies'),
  getCollection('people'),
]);
---
<BaseLayout>
  <h1 class="visually-hidden">AMS Signals Timeline</h1>
  <EventExplorer events={events} goldenEvents={events} companies={companies} people={people} context="global" />
</BaseLayout>
