---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventExplorer from '../components/EventExplorer.astro';

const [events, companies, people] = await Promise.all([
  getCollection('events'),
  getCollection('companies'),
  getCollection('people'),
]);
---
<BaseLayout>
  <section class="intro">
    <p class="eyebrow">FACTUAL PUBLIC TIMELINE</p>
    <h1>Public signals in RNM & mixed-signal verification</h1>
    <p class="lede">Compare dated records, search public evidence, and inspect every source. No technology tags, maturity scores, or inferred rankings.</p>
  </section>
  <EventExplorer events={events} goldenEvents={events} companies={companies} people={people} context="global" />
</BaseLayout>
