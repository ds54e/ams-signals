---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/paths';
import { areaIds, areaLabels, scopeLabels, linkLabels, sortProjects } from '../../lib/eda-tools/catalog';
import { projectTags } from '../../lib/catalog-roles';
import { monthLabel, shortMonth, shortDate } from '../../lib/eda-tools/activity';
import { validateActivity } from '../../lib/eda-tools/schema';
import activityData from '../../data/eda-tools-activity.json';
import '../../styles/eda-tools.css';

const entries = await getCollection('edaTools');
const activity = validateActivity(entries, activityData);
const projects = sortProjects(entries, activity.projects);
const projectLink = (slug: string) => sitePath(`eda-tools/#${slug}`);
const windowLabel = `${monthLabel(activity.months[0])}–${monthLabel(activity.months[11])}`;
---
<BaseLayout title="Digital / RTL · AMS Signals" description="RTL/digital tools and agents for simulation, compilation, verification, formal, debug and implementation flows." lang="en">
  <section class="eda-tools" data-eda-tools aria-labelledby="eda:heading">
    <h1 id="eda:heading" class="visually-hidden">Digital / RTL</h1>
    <section class="eda-landscape" aria-label="EDA landscape">
      <div class="eda-landscape-scroll" role="region" aria-label="EDA matrix; scroll horizontally for all scopes" tabindex="0">
        <table class="eda-landscape-table" aria-describedby="eda:legend">
          <caption class="visually-hidden">EDA scope by project</caption>
          <thead><tr><th scope="col">Project</th>{areaIds.map((id) => <th scope="col">{areaLabels[id]}</th>)}</tr></thead>
          <tbody>{projects.map(({ id, data }) => <tr data-eda-landscape-project={id}>
            <th scope="row"><a href={projectLink(id)}>{data.name}</a></th>
            {areaIds.map((area) => {
              const state = data.areas[area];
              const meaning = state ? scopeLabels[state] : 'No reviewed scope';
              return <td data-area={area} data-scope={state ?? ''} title={`${data.name} · ${areaLabels[area]}: ${meaning}`}>
                {state && <span aria-hidden="true" class:list={['eda-scope-mark', state]} />}
                <span class="visually-hidden">{meaning}</span>
              </td>;
            })}
          </tr>)}</tbody>
        </table>
      </div>
      <p id="eda:legend" class="eda-legend"><span><span class="eda-scope-mark core" aria-hidden="true" /><span class="visually-hidden">● </span>core</span><span><span class="eda-scope-mark supporting" aria-hidden="true" /><span class="visually-hidden">○ </span>supporting</span></p>
    </section>

    <section id="eda:index" aria-label="Project index">
      <div class="eda-columns" aria-hidden="true">
        <div>Project</div><div>Keywords</div>
        <div class="eda-activity-column"><span>Activity</span><div class="eda-activity-range" title={windowLabel}><span>{shortMonth(activity.months[0])}</span><span>{shortMonth(activity.months[11])}</span></div></div>
      </div>
      <ol class="eda-list" aria-label="Projects">
        {projects.map(({ data, id }) => {
          const record = activity.projects[id];
          return <li id={id} class="eda-project" data-eda-project tabindex="-1">
            <article aria-labelledby={`${id}--name`}>
              <div class="eda-overview">
                <div class="eda-title">
                  <h2 id={`${id}--name`}><a class="eda-permalink" href={projectLink(id)} aria-label={`Permalink to ${data.name}`}>{data.name}<span aria-hidden="true"> #</span></a></h2>
                  <ul class="eda-quicklinks" aria-label={`${data.name} primary links`}>
                    {data.sources.filter((source) => source.purpose).sort((a, b) => Object.keys(linkLabels).indexOf(a.purpose!) - Object.keys(linkLabels).indexOf(b.purpose!)).map((source) => <li><a href={source.url}>{linkLabels[source.purpose!]}</a></li>)}
                  </ul>
                </div>
                <p class="eda-description">{data.description}</p>
              </div>
              <ul class="eda-keywords" aria-label={`${data.name} project type and keywords`}>
                {projectTags(data.roles, data.ai === 'ai-built').map((tag) => <li data-tag-kind={tag.kind}>{tag.label}</li>)}
                {data.keywords.map((keyword) => <li data-tag-kind="keyword">{keyword}</li>)}
              </ul>
              <div class="eda-activity" data-activity-kind={record.kind}>
                <span class="visually-hidden">{record.kind === 'github' ? 'Public repository activity: ' : 'Public activity: '}</span>
                {record.kind === 'github' ? <>
                  <div class="eda-activity-top">
                    <p class="eda-activity-latest"><time datetime={record.lastCommitAt}>{shortDate(record.lastCommitAt, activity.reviewedAt)}</time></p>
                    <span class="eda-activity-summary">{record.commits.filter((count) => count > 0).length}/12 mo</span>
                  </div>
                  <ul class="eda-activity-strip" aria-label={`${data.name}: ${windowLabel}; ${record.repository}, default branch ${record.defaultBranch}`}>
                    {activity.months.map((month, index) => <li class:list={{ active: record.commits[index] > 0 }} data-month={month} data-commits={record.commits[index]} title={`${monthLabel(month)} · ${record.commits[index]} default-branch commits`}>
                      <span class="visually-hidden">{monthLabel(month)} · {record.commits[index]} default-branch commits</span>
                    </li>)}
                  </ul>
                </> : <p class="eda-activity-latest"><time datetime={record.lastPublicUpdateAt}>{shortDate(record.lastPublicUpdateAt, activity.reviewedAt)}</time></p>}
              </div>
            </article>
          </li>;
        })}
      </ol>
    </section>
  </section>
</BaseLayout>
