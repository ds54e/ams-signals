---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveRelatedEvents, validateArticleRelations } from '../../lib/articles';
import { sitePath } from '../../lib/paths';

export async function getStaticPaths() {
  const [articles, events] = await Promise.all([
    getCollection('articles'),
    getCollection('events'),
  ]);
  validateArticleRelations(articles, events);

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, relatedEvents: resolveRelatedEvents(article, events) },
  }));
}

const { article, relatedEvents } = Astro.props;
const { Content } = await render(article);
---
<BaseLayout
  title={`${article.data.title} · AMS Signals`}
  description={article.data.summary}
  lang="ja"
>
  <article class="document-page article-page">
    <header class="document-header article-header">
      <p class="quiet-meta article-dates">
        {article.data.updated ? (
          <>
            Published <time datetime={article.data.published}>{article.data.published}</time>
            {' · '}
            Updated <time datetime={article.data.updated}>{article.data.updated}</time>
          </>
        ) : (
          <time datetime={article.data.published}>{article.data.published}</time>
        )}
      </p>
      <h1>{article.data.title}</h1>
    </header>

    <div class="article-body">
      <Content />
    </div>

    {article.data.sources.length > 0 && (
      <section class="terminal-section article-sources" aria-labelledby="article-sources-heading">
        <h2 id="article-sources-heading">Sources</h2>
        <ol>
          {article.data.sources.map((source, index) => (
            <li id={`source-${index + 1}`}>
              <span class="article-source-number" aria-hidden="true">[{index + 1}]</span>
              <a href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {relatedEvents.length > 0 && (
      <section class="terminal-section article-related" aria-labelledby="related-events-heading">
        <h2 id="related-events-heading">Related events</h2>
        <ol>
          {relatedEvents.map((event) => (
            <li>
              <time datetime={event.data.when.start}>{event.data.when.start.slice(0, 4)}</time>
              <a href={sitePath(`events/${event.data.id}/`)}>{event.data.headline}</a>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</BaseLayout>
