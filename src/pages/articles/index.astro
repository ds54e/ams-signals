---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortArticlesNewestFirst } from '../../lib/articles';
import { sitePath } from '../../lib/paths';
import { englishAutoTranslationUrl } from '../../lib/translation';

const articles = sortArticlesNewestFirst(await getCollection('articles'));
if (!Astro.site) throw new Error('Astro site URL is required for Article translation links.');
const translationUrl = englishAutoTranslationUrl(new URL(sitePath('articles/'), Astro.site));
---
<BaseLayout
  title="Articles · AMS Signals"
  description="Researched editorial articles about RNM and mixed-signal verification."
  lang="ja"
>
  <section class="listing-page article-index" aria-labelledby="articles-heading">
    <h1 id="articles-heading" class="visually-hidden">Articles</h1>

    <p class="article-translation-utility" lang="en">
      <span>Japanese original</span>
      <span aria-hidden="true">·</span>
      <a
        class="article-translation-link"
        href={translationUrl}
        target="_blank"
        rel="noreferrer"
        title="Machine translation via Google Translate"
      >English (auto-translate) ↗</a>
    </p>

    {articles.length > 0 ? (
      <ol class="article-list">
        {articles.map((article) => (
          <li>
            <time datetime={article.data.published}>{article.data.published}</time>
            <div class="article-list-body">
              <h2><a href={sitePath(`articles/${article.id}/`)}>{article.data.title}</a></h2>
              <p>{article.data.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="article-empty">No articles yet.</p>
    )}
  </section>
</BaseLayout>
