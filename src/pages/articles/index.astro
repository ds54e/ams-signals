---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortArticlesNewestFirst } from '../../lib/articles';
import { sitePath } from '../../lib/paths';

const articles = sortArticlesNewestFirst(await getCollection('articles'));
---
<BaseLayout
  title="Articles · AMS Signals"
  description="Researched editorial articles about RNM and mixed-signal verification."
  lang="ja"
>
  <section class="listing-page article-index" aria-labelledby="articles-heading">
    <h1 id="articles-heading" class="visually-hidden">Articles</h1>
    <p class="index-count" lang="en">{articles.length} {articles.length === 1 ? 'article' : 'articles'}</p>

    {articles.length > 0 ? (
      <ol class="article-list index-list">
        {articles.map((article) => (
          <li class="index-row index-dated-row">
            <time class="index-date" datetime={article.data.published}>{article.data.published}</time>
            <div class="article-list-body">
              <h2 class="index-title"><a href={sitePath(`articles/${article.id}/`)}>{article.data.title}</a></h2>
              <p class="index-summary">{article.data.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="article-empty">No articles yet.</p>
    )}
  </section>
</BaseLayout>
