---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortArticlesNewestFirst } from '../../lib/articles';
import { sitePath } from '../../lib/paths';

const articles = sortArticlesNewestFirst(await getCollection('articles'));
---
<BaseLayout
  title="Articles · AMS Signals"
  description="Researched editorial articles about RNM and mixed-signal verification."
  lang="ja"
>
  <section class="listing-page article-index" aria-labelledby="articles-heading">
    <h1 id="articles-heading" class="visually-hidden">Articles</h1>

    {articles.length > 0 ? (
      <ol class="article-list">
        {articles.map((article) => (
          <li>
            <time datetime={article.data.published}>{article.data.published}</time>
            <h2><a href={sitePath(`articles/${article.id}/`)}>{article.data.title}</a></h2>
          </li>
        ))}
      </ol>
    ) : (
      <p class="article-empty">No articles yet.</p>
    )}
  </section>
</BaseLayout>
