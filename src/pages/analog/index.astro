---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/paths';
import { projectDetailAnchors, projectTags, sortProjects, workflowIds, workflowLabels, scopeLabels } from '../../lib/analog/catalog';
import { monthLabel, shortDate } from '../../lib/analog/activity';
import { validateActivity } from '../../lib/analog/schema';
import activityData from '../../data/analog-activity.json';
import '../../styles/analog.css';

const entries = await getCollection('analog');
const activity = validateActivity(entries, activityData);
const projects = sortProjects(entries, activity.projects);
const linkLabels = { official: 'Website', paper: 'Paper', code: 'Code', results: 'Results' };
const projectLink = (slug: string) => sitePath(`analog/#${slug}`);
const windowLabel = `${monthLabel(activity.months[0])}–${monthLabel(activity.months[11])}`;
---
<BaseLayout title="Analog · AMS Signals" description="Analog/RF/AMS tools, agents, benchmarks, datasets and design infrastructure." lang="en">
  <section class="analog" data-analog aria-labelledby="catalog:heading">
    <h1 id="catalog:heading" class="visually-hidden">Analog</h1>

    <section id="catalog:landscape" class="catalog-landscape" aria-label="Workflow landscape">
      <div class="landscape-scroll" role="region" aria-label="Landscape matrix; scroll horizontally for all scopes" tabindex="0">
        <table class="landscape-table" aria-describedby="catalog:legend">
          <caption class="visually-hidden">Workflow scope by project</caption>
          <thead><tr><th scope="col">Project</th>{workflowIds.map((id) => <th scope="col">{workflowLabels[id]}</th>)}</tr></thead>
          <tbody>{projects.map(({ id, data }) => <tr data-landscape-project={id}>
            <th scope="row"><a href={projectLink(id)}>{data.name}</a></th>
            {workflowIds.map((stage) => {
              const state = data.workflow[stage];
              const meaning = state ? scopeLabels[state] : 'No reviewed scope';
              return <td data-workflow={stage} data-scope={state ?? ''} title={`${data.name} · ${workflowLabels[stage]}: ${meaning}`}>
                {state && <span aria-hidden="true" class:list={['scope-mark', state]} />}
                <span class="visually-hidden">{meaning}</span>
              </td>;
            })}
          </tr>)}</tbody>
        </table>
      </div>
      <p id="catalog:legend" class="catalog-legend"><span><span class="scope-mark core" aria-hidden="true" /><span class="visually-hidden">● </span>core</span><span><span class="scope-mark supporting" aria-hidden="true" /><span class="visually-hidden">○ </span>supporting</span></p>
    </section>

    <section id="catalog:index" aria-label="Project index">
      <div class="catalog-columns" aria-hidden="true">
        <div>Project</div><div>Keywords</div><div>Activity</div>
      </div>
      <ol class="catalog-list" aria-label="Projects">
        {projects.map((project) => {
          const { data, id } = project;
          const record = activity.projects[id];
          if (!project.rendered) throw new Error(`Missing rendered catalog content: ${id}`);
          // Old research bookmarks now lead to the always-visible project description.
          const aliases = [
            ...projectDetailAnchors(project.rendered.html, id),
            `${id}--sources`,
            ...data.sources.filter((source) => !source.purpose).map((source) => `${id}--source-${source.id}`),
          ];
          return <li id={id} class="catalog-project" data-catalog-project tabindex="-1">
            {aliases.map((anchor) => <span id={anchor} class="catalog-anchor" aria-hidden="true" />)}
            <article aria-labelledby={`${id}--name`}>
              <div class="catalog-overview">
                <div class="catalog-title">
                  <h2 id={`${id}--name`}><a class="catalog-permalink" href={projectLink(id)} aria-label={`Permalink to ${data.name}`}>{data.name}<span aria-hidden="true"> #</span></a></h2>
                  <ul class="catalog-quicklinks" aria-label={`${data.name} primary links`}>
                    {data.sources.filter((source) => source.purpose).sort((a, b) => Object.keys(linkLabels).indexOf(a.purpose!) - Object.keys(linkLabels).indexOf(b.purpose!)).map((source) => <li id={`${id}--source-${source.id}`}><a href={source.url}>{linkLabels[source.purpose!]}</a></li>)}
                  </ul>
                </div>
                <p class="catalog-description">{data.description}</p>
              </div>
              <ul class="catalog-keywords" aria-label={`${data.name} project type and keywords`}>
                {projectTags(data.roles, data.aiBuilt).map((tag) => <li data-tag-kind={tag.kind}>{tag.label}</li>)}
                {data.keywords.map((keyword) => <li data-tag-kind="keyword">{keyword}</li>)}
              </ul>
              <div class="catalog-activity" data-activity-kind={record.kind}>
                <span class="visually-hidden">{record.kind === 'github' ? 'Public repository activity: ' : 'Public activity: '}</span>
                {record.kind === 'github' ? <>
                  <p class="activity-latest"><time datetime={record.lastCommitAt}>{shortDate(record.lastCommitAt, activity.reviewedAt)}</time></p>
                  <ul class="activity-strip" aria-label={`${data.name}: ${windowLabel}; ${record.repository}, default branch ${record.defaultBranch}`}>
                    {activity.months.map((month, index) => <li class:list={{ active: record.commits[index] > 0 }} data-month={month} data-commits={record.commits[index]} title={`${monthLabel(month)} · ${record.commits[index]} default-branch commits`}>
                      <span class="visually-hidden">{monthLabel(month)} · {record.commits[index]} default-branch commits</span>
                    </li>)}
                  </ul>
                  <p class="activity-summary">{record.commits.filter((count) => count > 0).length}/12 months</p>
                </> : <>
                  {record.lastPublicUpdateAt && <p class="activity-latest">{data.sources.find((source) => source.id === record.lastPublicUpdateSource)?.purpose === 'paper' ? 'Paper ' : ''} <time datetime={record.lastPublicUpdateAt}>{shortDate(record.lastPublicUpdateAt, activity.reviewedAt)}</time></p>}
                </>}
              </div>
            </article>
          </li>;
        })}
      </ol>
    </section>
  </section>
</BaseLayout>
