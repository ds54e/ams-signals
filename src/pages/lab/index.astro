---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogIndex from '../../components/CatalogIndex.astro';
import { sortProjects, scopeStageLabels } from '../../lib/lab/catalog';
import { validateActivity } from '../../lib/lab/schema';
import { scopeItems } from '../../lib/catalog-scope';
import { activityBand } from '../../lib/catalog-activity-band';
import activityData from '../../data/lab-activity.json';

const entries = await getCollection('lab');
const activity = validateActivity(entries, activityData);
const projects = sortProjects(entries, activity.projects).map(({ data, id }) => {
  const record = activity.projects[id];
  const band = activityBand(record, activity.months, data.sources);
  return {
    id, name: data.name, aliases: data.aliases, description: data.description, sources: data.sources,
    scope: scopeItems(data.scope, scopeStageLabels), developmentEvidence: data.developmentEvidence,
    activity: { ...band, kind: record.kind },
  };
});
---
<BaseLayout title="Lab: Board, Test & Measurement · AMS Signals" description="Evaluation boards, fixtures, instrument control, measurement, and test automation." lang="en">
  <CatalogIndex domain="lab" title="Lab" heading="Lab: Board, Test & Measurement" stages={scopeStageLabels} months={activity.months} projects={projects} />
</BaseLayout>
