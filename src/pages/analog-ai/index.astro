---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/paths';
import { namespaceProjectHtml, roleIds, roleLabels, sortProjects } from '../../lib/analog-ai/catalog';
import { validateCatalog } from '../../lib/analog-ai/schema';
import updateData from '../../data/analog-ai-updates.json';
import '../../styles/analog-ai.css';

const projects = sortProjects(await getCollection('analogAi'));
const updates = validateCatalog(projects, updateData);
const projectNames = new Map(projects.map((project) => [project.id, project.data.name]));
const linkLabels = { official: 'Website', paper: 'Paper', code: 'Code', results: 'Results' };
const projectLink = (slug: string) => sitePath(`analog-ai/#${slug}`);
---
<BaseLayout
  title="Analog AI benchmarks and tools · AMS Signals"
  description="A technical catalog of AI benchmarks, design agents, EDA tools, and experiment environments for analog, RF, and mixed-signal circuit design."
  lang="en"
>
  <section class="analog-ai listing-page" data-analog-ai aria-labelledby="catalog:heading">
    <header class="catalog-header">
      <p class="catalog-kicker">Project catalog</p>
      <h1 id="catalog:heading">Analog AI benchmarks and tools</h1>
      <p>Benchmarks, design agents, EDA tools, and experiment environments for analog, RF, and mixed-signal circuit design.</p>
    </header>

    {updates.length > 0 && (
      <aside class="catalog-updates" aria-labelledby="catalog:updates">
        <h2 id="catalog:updates">Recent additions & major updates</h2>
        <ul>
          {updates.map((update) => (
            <li>
              <time datetime={update.date}>{update.date}</time>
              <span>{update.kind === 'added' ? 'Added' : 'Updated'} · <a href={projectLink(update.project)}>{projectNames.get(update.project)}</a> — {update.summary}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <form class="catalog-controls" data-catalog-controls hidden role="search" aria-label="Search Analog AI" action={sitePath('analog-ai/')}>
      <div class="catalog-fields">
        <label for="catalog:search">Search
          <input id="catalog:search" data-catalog-search type="search" name="q" placeholder="e.g. LDO ngspice" autocomplete="off" aria-describedby="catalog:search-help" />
        </label>
        <label for="catalog:type">Category
          <select id="catalog:type" data-catalog-type name="type">
            <option value="">All</option>
            {roleIds.map((role) => <option value={role}>{roleLabels[role]}</option>)}
          </select>
        </label>
      </div>
      <div class="catalog-control-footer">
        <p data-catalog-count role="status" aria-live="polite" aria-atomic="true">Showing {projects.length} of {projects.length} projects</p>
        <button type="reset">Reset filters</button>
      </div>
      <p id="catalog:search-help" class="catalog-help">All search terms must match. Search includes limitations and features that are not evaluated.</p>
    </form>
    <p class="catalog-static-count" data-catalog-static-count>{projects.length} projects · Name order</p>
    <noscript><p class="catalog-help">All projects are shown. Use your browser's Find command to search the page; project details and sources are available below.</p></noscript>
    <p class="catalog-notice" data-catalog-notice role="status" hidden></p>
    <p class="catalog-empty" data-catalog-empty hidden>No matching projects. Change your search or category, or select “Reset filters”.</p>

    <ol class="catalog-list" aria-label="Projects">
      {projects.map((project) => {
        const { data, id } = project;
        if (!project.rendered) throw new Error(`Missing rendered catalog content: ${id}`);
        return (
          <li id={id} class="catalog-project" data-catalog-project data-roles={JSON.stringify(data.roles)} data-aliases={JSON.stringify(data.aliases)}>
            <article aria-labelledby={`${id}--name`}>
              <header class="catalog-project-header">
                <h2 id={`${id}--name`} data-searchable>{data.name}</h2>
                <ul class="catalog-roles" aria-label="Categories" data-searchable>
                  {data.roles.map((role) => <li>{roleLabels[role]}</li>)}
                </ul>
              </header>
              <p class="catalog-summary" data-searchable>{data.summary}</p>
              {data.targets && <p class="catalog-meta" data-searchable><strong>Targets</strong>{data.targets}</p>}
              <p class="catalog-meta" data-searchable><strong>Access & environment</strong>{data.access}</p>
              {data.notice && <p class="catalog-condition" data-searchable>{data.notice}</p>}
              <div class="catalog-links">
                <ul aria-label={`${data.name} primary links`}>
                  {data.sources.filter((source) => source.purpose).map((source) => (
                    <li><a href={source.url}>{linkLabels[source.purpose!]}<span aria-hidden="true"> ↗</span></a></li>
                  ))}
                </ul>
                <a class="catalog-permalink" href={projectLink(id)} aria-label={`Permalink to ${data.name}`}>Permalink<span aria-hidden="true"> #</span></a>
              </div>
              <details open>
                <summary>Details & sources<span class="visually-hidden">: {data.name}</span></summary>
                <div class="catalog-detail" data-searchable set:html={namespaceProjectHtml(project.rendered.html, id)} />
                <section class="catalog-sources" aria-labelledby={`${id}--sources`}>
                  <h3 id={`${id}--sources`}>Primary sources</h3>
                  <ol>
                    {data.sources.map((source) => <li id={`${id}--source-${source.id}`}><a href={source.url}>{source.title}</a></li>)}
                  </ol>
                  <p class="catalog-review">Added to catalog: <time datetime={data.addedAt}>{data.addedAt}</time> · Sources reviewed: <time datetime={data.reviewedAt}>{data.reviewedAt}</time></p>
                </section>
              </details>
            </article>
          </li>
        );
      })}
    </ol>
    <footer class="catalog-publication-note">
      <p>Descriptions are based on the primary sources reviewed on each entry's stated date. Results are author-reported unless noted; no independent reproduction is claimed. Implemented capabilities, experimental features, and planned work are distinguished within each entry.</p>
    </footer>
  </section>
</BaseLayout>

<script>
  import { initializeCatalog } from '../../lib/analog-ai/browser';
  initializeCatalog();
</script>
