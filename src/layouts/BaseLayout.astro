---
import '../styles/global.css';
import { sitePath } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'AMS Signals',
  description = 'Public signals in RNM and mixed-signal verification.',
  lang = 'en',
} = Astro.props;
const inEvents = Astro.url.pathname.startsWith(sitePath('events/'));
const inArticles = Astro.url.pathname.startsWith(sitePath('articles/'));
const inAnalogAi = Astro.url.pathname.startsWith(sitePath('analog-ai/'));
const inTimeline = Astro.url.pathname === sitePath('');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={sitePath('')}>AMS Signals</a>
      <nav aria-label="Primary">
        <a href={sitePath('')} data-filter-view-link data-filter-surface="timeline" aria-current={inTimeline ? 'page' : undefined}>Timeline</a>
        <a href={sitePath('events/')} data-filter-view-link data-filter-surface="events" aria-current={inEvents ? 'page' : undefined}>Events</a>
        <a href={sitePath('articles/')} aria-current={inArticles ? 'page' : undefined}>Articles</a>
        <a href={sitePath('analog-ai/')} aria-current={inAnalogAi ? 'page' : undefined}>Analog AI</a>
      </nav>
    </header>
    <main class="page-shell">
      <slot />
    </main>
  </body>
</html>
