{
  "name": "ams-signals",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "node tools/validate.mjs",
    "validate:analog": "node tools/validate-analog.mjs",
    "test:analog": "node --test tests/analog/*.test.ts",
    "lint:facts": "node tools/fact-lint.mjs",
    "check:duplicates": "node tools/duplicate-check.mjs",
    "check:internal-links": "node tools/internal-link-check.mjs",
    "check:indexing": "node tools/check-indexing.mjs",
    "check:analytics": "node tools/check-analytics.mjs",
    "check": "node tools/validate.mjs && node tools/fact-lint.mjs && node tools/duplicate-check.mjs && node tools/validate-analog.mjs && node tools/validate-digital.mjs && node tools/validate-lab.mjs && npm run test:contracts && astro build && node tools/internal-link-check.mjs && node tools/check-indexing.mjs && node tools/check-analytics.mjs",
    "test:smoke": "npm run build && playwright test",
    "test:golden": "node --test tests/golden/*.test.ts",
    "test:contracts": "node --test \"tests/**/*.test.{ts,mjs}\"",
    "refresh:analog-activity": "node tools/refresh-analog-activity.mjs",
    "validate:digital": "node tools/validate-digital.mjs",
    "test:digital": "node --test tests/digital/*.test.ts",
    "refresh:digital-activity": "node tools/refresh-digital-activity.mjs",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:live": "playwright test --config playwright.live.config.mjs",
    "validate:lab": "node tools/validate-lab.mjs",
    "test:lab": "node --test tests/lab/*.test.ts",
    "refresh:lab-activity": "node tools/refresh-lab-activity.mjs"
  },
  "dependencies": {
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
