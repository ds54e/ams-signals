{
  "name": "ams-signals",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "node tools/validate.mjs",
    "validate:analog": "node tools/validate-analog.mjs",
    "test:analog": "node --test tests/analog/*.test.ts",
    "lint:facts": "node tools/fact-lint.mjs",
    "check:duplicates": "node tools/duplicate-check.mjs",
    "check:internal-links": "node tools/internal-link-check.mjs",
    "check": "npm run validate && npm run lint:facts && npm run check:duplicates && npm run validate:analog && npm run test:analog && npm run validate:digital && npm run test:digital && npm run build && npm run check:internal-links",
    "test:smoke": "npm run build && playwright test",
    "refresh:analog-activity": "node tools/refresh-analog-activity.mjs",
    "validate:digital": "node tools/validate-digital.mjs",
    "test:digital": "node --test tests/digital/*.test.ts",
    "refresh:digital-activity": "node tools/refresh-digital-activity.mjs"
  },
  "dependencies": {
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
